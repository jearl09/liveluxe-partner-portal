# Copy to .env.local for local development. NEVER commit real values — not even here (spec §5.3).
# Only NEXT_PUBLIC_* reaches the browser. Everything else is server-only.
# Business tunables (hold duration, SLA, deposit %, tax rules…) live in the `settings` table, not here.

NODE_ENV=development
VERCEL_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (local stack: `supabase start` prints these) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRET — bypasses RLS; used only by lib/db/admin.ts
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Hostaway (use the TEST account; never the live account outside production) ---
HOSTAWAY_ACCOUNT_ID=                  # OAuth client_id (Settings → Hostaway API)
HOSTAWAY_API_KEY=                     # SECRET — shown once at creation
HOSTAWAY_WEBHOOK_USER=                # ≥ 16 random chars, Basic auth username on the unified webhook
HOSTAWAY_WEBHOOK_PASSWORD=            # ≥ 32 random chars
HOSTAWAY_WEBHOOK_PATH_SECRET=         # ≥ 32 random chars → /api/webhooks/hostaway/{this}
HOSTAWAY_ALLOW_WRITES=false           # 'true' in production, or with HOSTAWAY_WRITE_TARGET=test against the TEST account
HOSTAWAY_WRITE_TARGET=production      # 'test' = writes go to the declared test account (never allowed in production)
HOSTAWAY_TEST_ACCOUNT_ID=             # the TEST account's Account ID; must equal HOSTAWAY_ACCOUNT_ID when WRITE_TARGET=test
HOSTAWAY_DIRECT_CHANNEL_ID=           # fallback only; the channel id lives in settings.hostaway.direct_channel_id (§6.7)

# --- Live verification (npm run verify:live) — opt-in, Stripe TEST mode + Hostaway TEST account only ---
LIVE_VERIFY=0                         # set to 1 to allow verify:live to run
LIVE_HOSTAWAY_LISTING_ID=             # a listing in the Hostaway TEST account that has been synced into this database

# --- Stripe (test mode locally; `stripe listen --forward-to localhost:3000/api/webhooks/stripe`) ---
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_          # per environment

# --- Email (Resend; verified sending subdomain with SPF/DKIM/DMARC) ---
RESEND_API_KEY=
EMAIL_FROM=bookings@book.livluxe.com.au
EMAIL_REPLY_TO=partners@livluxe.com.au

# --- Slack (optional locally) ---
SLACK_WEBHOOK_URL=
SLACK_ALERTS_WEBHOOK_URL=

# --- Maps (MapTiler or Mapbox; domain-restricted key) ---
NEXT_PUBLIC_MAP_TILE_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Scheduled jobs ---
CRON_SECRET=                          # ≥ 32 random chars; Vercel sends it as Authorization: Bearer

# --- Observability (optional locally) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
