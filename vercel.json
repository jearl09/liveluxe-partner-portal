{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "crons": [
    { "path": "/api/cron/sync-listings", "schedule": "0 * * * *" },
    { "path": "/api/cron/sync-calendar-near", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/sync-calendar-far", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/drain-webhooks", "schedule": "* * * * *" },
    { "path": "/api/cron/expire-holds", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/sla-escalation", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/release-checkin", "schedule": "0 * * * *" },
    { "path": "/api/cron/reconcile-hostaway", "schedule": "15 3 * * *" },
    { "path": "/api/cron/reconcile-stripe", "schedule": "45 3 * * *" },
    { "path": "/api/cron/check-authorisations", "schedule": "0 9 * * *" },
    { "path": "/api/cron/invoice-dunning", "schedule": "0 10 * * *" },
    { "path": "/api/cron/complete-stays", "schedule": "30 4 * * *" },
    { "path": "/api/cron/token-health", "schedule": "0 8 * * *" },
    { "path": "/api/cron/digests", "schedule": "0 7 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    }
  ]
}
